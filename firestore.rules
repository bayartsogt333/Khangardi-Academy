rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isEnrolled(courseId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid))
        && get(/databases/$(database)/documents/courses/$(courseId)/enrollments/$(request.auth.uid)).data.status == 'approved';
    }

    // Users: allow a signed-in user to create their own profile document under /users/{uid}
    // Users may read their own profile; admins may read any profile.
    // Only admins (custom claim `admin`) may change the `role` field or delete profiles.
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        // ensure the email in the incoming profile matches the authenticated token's email
        && (request.resource.data.email == request.auth.token.email || request.auth.token.email == null);

      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true)
        // non-admins may not change the `role` field
        && (isAdmin() || request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // Community posts: anybody can read posts; authenticated users can create posts where
    // `authorId` equals their uid. Only the author or admins can modify/delete a post.
    match /community/groups/items/{groupId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);
    }

    // Community collection used by the app: /community/posts/items/{postId}
    match /community/posts/items/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.groupId is string
        && request.resource.data.groupType in ['general', 'course', 'custom']
        && (
          (request.resource.data.groupType == 'general' && request.resource.data.groupId == 'general')
          || (
            request.resource.data.groupType == 'course'
            && request.resource.data.courseId is string
            && request.resource.data.groupId == request.resource.data.courseId
            && exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
            && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.status == 'published'
          )
          || (
            request.resource.data.groupType == 'custom'
            && exists(/databases/$(database)/documents/community/groups/items/$(request.resource.data.groupId))
          )
        );

      // Allow updates if author/admin, or allow authenticated users to only toggle likes (add/remove their uid)
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId || isAdmin() || (
          // only 'likes' and 'updatedAt' may be changed by non-authors
          request.resource.data.keys().hasOnly(['likes','updatedAt','authorId','authorName','text','createdAt','groupId','groupType','courseId','groupTitle'])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.groupType == resource.data.groupType
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.groupTitle == resource.data.groupTitle
          // ensure likes change is either addition or removal of the current user's id
          && (
            (request.resource.data.likes.hasAll(resource.data.likes) && request.resource.data.likes.size() == resource.data.likes.size() + 1 && request.resource.data.likes.hasAny([request.auth.uid]))
            || (resource.data.likes.hasAll(request.resource.data.likes) && resource.data.likes.size() == request.resource.data.likes.size() + 1 && resource.data.likes.hasAny([request.auth.uid]))
          )
        )
      );

      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || isAdmin());

      // Comments nested under a post
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;

        allow update: if request.auth != null && (
          request.auth.uid == resource.data.authorId || isAdmin() || (
            request.resource.data.keys().hasOnly(['likes','updatedAt','authorId','authorName','text','createdAt'])
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.text == resource.data.text
            && request.resource.data.createdAt == resource.data.createdAt
            && (
              (request.resource.data.likes.hasAll(resource.data.likes) && request.resource.data.likes.size() == resource.data.likes.size() + 1 && request.resource.data.likes.hasAny([request.auth.uid]))
              || (resource.data.likes.hasAll(request.resource.data.likes) && resource.data.likes.size() == request.resource.data.likes.size() + 1 && resource.data.likes.hasAny([request.auth.uid]))
            )
          )
        );

        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId
          || isAdmin()
          || request.auth.uid == get(/databases/$(database)/documents/community/posts/items/$(postId)).data.authorId
        );
      }
    }

    // Classrooms: allow read for authenticated users; creation requires auth; admin-only updates/deletes.
    match /classrooms/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Courses: top-level courses collection with nested sections and lessons.
    // Reads are public; creation/updates/deletes require an admin custom claim.
    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || isAdmin() || isEnrolled(courseId);

      // Only authenticated admins may create courses. Ensure createdBy matches the auth uid.
      allow create: if request.auth != null
        && isAdmin()
        && request.resource.data.createdBy == request.auth.uid;

      // Only admins may update or delete courses.
      allow update, delete: if isAdmin();

      // Sections subcollection
      match /sections/{sectionId} {
        allow read: if isAdmin() || isEnrolled(courseId);
        allow create: if isAdmin();
        allow update, delete: if isAdmin();

        // Lessons nested under sections
        match /lessons/{lessonId} {
          allow read: if isAdmin() || isEnrolled(courseId);
          allow create: if isAdmin();
          allow update, delete: if isAdmin();
        }
      }
    }

    // Enrollments: users may create/read their own enrollment doc; admins may read all.
    match /courses/{courseId}/enrollments/{userId} {
      allow create: if request.auth != null
        && request.resource.data.userId == userId
        && request.resource.data.courseId == courseId
        && (
          (request.auth.uid == userId && request.resource.data.status == 'pending')
          || isAdmin()
        );

      allow read: if request.auth != null && (isAdmin() || request.auth.uid == userId);

      allow update: if request.auth != null && (
        isAdmin() || (
          request.auth.uid == userId
          && resource.data.status != 'approved'
          && request.resource.data.userId == userId
          && request.resource.data.courseId == courseId
          && request.resource.data.status == 'pending'
        )
      );

      allow delete: if request.auth != null && (
        isAdmin() || (request.auth.uid == userId && resource.data.status != 'approved')
      );
    }

    // Lesson progress: users track their own completed lessons; admins may inspect all progress.
    match /courses/{courseId}/lessonProgress/{userId}/lessons/{lessonId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.courseId == courseId
        && request.resource.data.lessonId == lessonId;

      allow read: if request.auth != null && (isAdmin() || request.auth.uid == userId);

      allow update, delete: if request.auth != null && (isAdmin() || request.auth.uid == userId);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}