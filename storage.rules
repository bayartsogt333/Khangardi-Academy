rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Allow public reads for uploaded course thumbnails but restrict writes to admins.
    match /courses/{courseId}/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny writes to any other paths by default (reads allowed for public assets).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
