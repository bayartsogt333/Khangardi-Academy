rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public reads for uploaded course thumbnails but restrict writes to admins.
    // This assumes you set a custom `admin` boolean on the user's auth token (custom claim).
    match /courses/{courseId}/{filePath=**} {
      allow read: if true;
      // DEVELOPMENT: allow any authenticated user to upload thumbnails so you can finish building the UI.
      // WARNING: this is less secure — revert to admin-only writes before production.
      allow write: if request.auth != null;
    }

    // Deny writes to any other paths by default (reads allowed for public assets).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
